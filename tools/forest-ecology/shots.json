  "eval": "(()=>{const g=window.__game,w=g.world,e=w.ecology,c=g.campOf(0),h={};for(let dz=-80;dz<=80;dz+=12)for(let dx=-80;dx<=80;dx+=12){const gx=Math.max(0,Math.min(e.width-1,Math.floor(((c.x+dx)/e.size+.5)*e.width))),gz=Math.max(0,Math.min(e.width-1,Math.floor(((c.z+dz)/e.size+.5)*e.width)));const k=e.kinds[gz*e.width+gx];h[k]=(h[k]||0)+1;}return {camp:[Math.round(c.x),Math.round(c.z)],kinds:h};})()",
  "treeSet": "botanical",
